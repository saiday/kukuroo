{
  "name": "kukuroo",
  "version": "0.1.0",
  "description": "Send Web Push notifications to your own devices from anything. Cloudflare Worker + KV, Declarative Web Push, no third-party service.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "scripts",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "prepublishOnly": "npm test && npm run typecheck",
    "init": "node scripts/init.mjs init",
    "test": "node --experimental-strip-types --no-warnings test/crypto.test.mjs && node --experimental-strip-types --no-warnings test/mount.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "kukuroo": "scripts/init.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "author": "Saiday",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiday/kukuroo.git"
  },
  "homepage": "https://github.com/saiday/kukuroo#readme",
  "bugs": "https://github.com/saiday/kukuroo/issues",
  "keywords": [
    "web-push",
    "push-notifications",
    "cloudflare-workers",
    "declarative-web-push",
    "vapid",
    "ios",
    "pwa",
    "self-hosted",
    "serverless"
  ],
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  }
}
